-- ============================================================
--  TrySchedule – Supabase Migration
-- ============================================================
--  Supabase 대시보드 → SQL Editor 에 붙여넣고 실행하세요.
--  (또는 supabase migration 폴더에 .sql 로 저장 후 push)
--
--  생성되는 테이블:
--   1) try_schedules    : 트라이 프로젝트 (상위)
--   2) try_sessions     : 날짜별 트라이 세션/진행도 메모
--   3) try_participants : 참가자 슬롯
-- ============================================================

-- ── 1. try_schedules ────────────────────────────────────────
create table if not exists public.try_schedules (
  id            uuid primary key default gen_random_uuid(),
  raid_name     text not null,
  difficulty    text,                              -- '노말' / '하드' / '익스트림' / '헬'
  party_size    int  not null default 8 check (party_size in (4, 8)),
  status        text not null default 'active'
                check (status in ('active','paused','cleared')),
  current_gate  int  not null default 1,
  total_gates   int  not null default 4,
  start_date    date,
  cleared_date  date,
  description   text,
  created_by    uuid not null references auth.users(id) on delete cascade,
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

create index if not exists try_schedules_status_idx       on public.try_schedules(status);
create index if not exists try_schedules_created_by_idx   on public.try_schedules(created_by);
create index if not exists try_schedules_created_at_idx   on public.try_schedules(created_at desc);

-- ── 2. try_sessions ─────────────────────────────────────────
create table if not exists public.try_sessions (
  id            uuid primary key default gen_random_uuid(),
  try_id        uuid not null references public.try_schedules(id) on delete cascade,
  session_date  date not null,
  session_time  time,
  attempt_note  text,
  created_by    uuid not null references auth.users(id) on delete cascade,
  created_at    timestamptz not null default now()
);

create index if not exists try_sessions_try_id_idx        on public.try_sessions(try_id);
create index if not exists try_sessions_session_date_idx  on public.try_sessions(session_date);

-- ── 3. try_participants ─────────────────────────────────────
create table if not exists public.try_participants (
  id              uuid primary key default gen_random_uuid(),
  try_id          uuid not null references public.try_schedules(id) on delete cascade,
  user_id         uuid not null references auth.users(id) on delete cascade,
  character_name  text,
  role            text check (role in ('딜러','서포터')),
  joined_at       timestamptz not null default now(),
  unique(try_id, user_id)
);

create index if not exists try_participants_try_id_idx    on public.try_participants(try_id);
create index if not exists try_participants_user_id_idx   on public.try_participants(user_id);

-- ============================================================
--  RLS 정책
-- ============================================================

-- profiles.role 을 가져오는 헬퍼 함수
-- ※ 이미 같은 함수가 있다면 이 블록은 건너뛰어도 됩니다.
create or replace function public.is_staff(uid uuid)
returns boolean
language sql
security definer
stable
as $$
  select coalesce(
    (select role in ('admin','submaster') from public.profiles where id = uid),
    false
  );
$$;

-- ── try_schedules RLS ───────────────────────────────────────
alter table public.try_schedules enable row level security;

drop policy if exists try_schedules_select on public.try_schedules;
create policy try_schedules_select on public.try_schedules
  for select using (true);

drop policy if exists try_schedules_insert on public.try_schedules;
create policy try_schedules_insert on public.try_schedules
  for insert with check (auth.uid() = created_by);

drop policy if exists try_schedules_update on public.try_schedules;
create policy try_schedules_update on public.try_schedules
  for update using (auth.uid() = created_by or public.is_staff(auth.uid()));

drop policy if exists try_schedules_delete on public.try_schedules;
create policy try_schedules_delete on public.try_schedules
  for delete using (auth.uid() = created_by or public.is_staff(auth.uid()));

-- ── try_sessions RLS ────────────────────────────────────────
alter table public.try_sessions enable row level security;

drop policy if exists try_sessions_select on public.try_sessions;
create policy try_sessions_select on public.try_sessions
  for select using (true);

drop policy if exists try_sessions_insert on public.try_sessions;
create policy try_sessions_insert on public.try_sessions
  for insert with check (auth.uid() = created_by);

drop policy if exists try_sessions_update on public.try_sessions;
create policy try_sessions_update on public.try_sessions
  for update using (auth.uid() = created_by or public.is_staff(auth.uid()));

drop policy if exists try_sessions_delete on public.try_sessions;
create policy try_sessions_delete on public.try_sessions
  for delete using (auth.uid() = created_by or public.is_staff(auth.uid()));

-- ── try_participants RLS ────────────────────────────────────
alter table public.try_participants enable row level security;

drop policy if exists try_participants_select on public.try_participants;
create policy try_participants_select on public.try_participants
  for select using (true);

-- 본인 슬롯만 신청 가능
drop policy if exists try_participants_insert on public.try_participants;
create policy try_participants_insert on public.try_participants
  for insert with check (auth.uid() = user_id);

-- 본인 슬롯 또는 트라이 생성자, 또는 스태프가 제거 가능
drop policy if exists try_participants_delete on public.try_participants;
create policy try_participants_delete on public.try_participants
  for delete using (
       auth.uid() = user_id
    or public.is_staff(auth.uid())
    or exists (
         select 1 from public.try_schedules t
          where t.id = try_id and t.created_by = auth.uid()
       )
  );

-- ============================================================
--  Realtime 활성화 (선택)
-- ============================================================
--  Supabase 대시보드 → Database → Replication 에서
--  try_schedules / try_sessions / try_participants 테이블의
--  실시간 구독을 켜주세요.
--  (또는 아래 SQL 실행)

alter publication supabase_realtime add table public.try_schedules;
alter publication supabase_realtime add table public.try_sessions;
alter publication supabase_realtime add table public.try_participants;

